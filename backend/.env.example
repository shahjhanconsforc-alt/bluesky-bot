# bluesky-bot settings. Read by run.py and backend/config.py; a value exported
# in the shell wins over this file. Gitignored - the MinIO password is here.

XBOT_HOST=127.0.0.1
XBOT_PORT=4300
XBOT_HEADLESS=0
XBOT_BROWSER_CHANNEL=chrome
XBOT_RELOAD=0

#---------------------------MINIO CONFIGURATION---------------------------
MINIO_URL=localhost:9000
MINIO_USER=admin
MINIO_PASSWORD=change-me
MINIO_BUCKET=insta-bot-usernames
# The scraped handles (handle, name, bio, followers - tab-separated) go here.
MINIO_HANDLES_OBJECT=bluesky_handles.txt

# Sessions: one zip per account (session-acct-<id>.zip) in this bot's own
# bucket, made on the first saved session. Log out / remove deletes them.
MINIO_SESSIONS_BUCKET=bluesky-bot-sessions

# The Campaign panel's Messages and Media.
# Messages: the drafts table (id, name, text, disabled - tab-separated).
MINIO_MESSAGES_BUCKET=campaign-sms
MINIO_MESSAGES_OBJECT=sms_drafts.txt
# Media: every image in this bucket (optionally only under MINIO_MEDIA_PREFIX).
MINIO_MEDIA_BUCKET=campaign-media
MINIO_MEDIA_PREFIX=
